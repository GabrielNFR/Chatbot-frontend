# URL base da API. Vazio = mesma origem (/api) — modo usado em dev (proxy do
# Vite) e em producao (Nginx). So preencha se o backend estiver em outro host
# e sem proxy.
# Copie para .env.local para sobrescrever localmente.
VITE_API_URL=

# "false" desliga os mocks e passa a chamar a API real. Padrao: mocks ligados.
VITE_USAR_MOCK=true
