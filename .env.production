# Aplicado automaticamente por `pnpm build` (mode=production).
# NÃO afeta `pnpm dev` (mode=development) — para o dev, use `.env.local`.

# URL relativa = mesma origem. Em produção o Nginx faz /api -> Spring Boot.
VITE_API_URL=

# O bundle de produção fala com a API real, não com os mocks.
VITE_USAR_MOCK=false
